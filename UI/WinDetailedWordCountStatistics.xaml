<Window x:Class="TypeSunny.UI.WinDetailedWordCountStatistics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="详细字数统计" Height="800" Width="1180" Icon="/Resources/ico/sunny.ico"
        MinHeight="720" MinWidth="1000"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="PanelButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="mainBorder"
                CornerRadius="7"
                BorderThickness="1"
                Margin="5"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        x:Name="titleBarBorder"
                        CornerRadius="6,6,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid x:Name="titleBarGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Image x:Name="titleBarIcon" Source="/Resources/ico/sunny.ico" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtTitle"
                                       Text="详细字数统计"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource SunnyTitleBarMinimizeButtonStyle}"/>
                            <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource SunnyTitleBarMaximizeButtonStyle}"/>
                            <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource SunnyTitleBarCloseIconButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" x:Name="summaryGrid" Margin="12,10,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" x:Name="summaryTotalBorder" BorderThickness="1" Padding="10,7" Margin="0,0,8,0" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="总字数" FontSize="12"/>
                            <TextBlock x:Name="txtTotalWords" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" x:Name="summaryArticleBorder" BorderThickness="1" Padding="10,7" Margin="0,0,8,0" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="文章字数" FontSize="12"/>
                            <TextBlock x:Name="txtArticleWords" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" x:Name="summaryTrainerBorder" BorderThickness="1" Padding="10,7" Margin="0,0,8,0" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="练单字数" FontSize="12"/>
                            <TextBlock x:Name="txtTrainerWords" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" x:Name="summaryStartBorder" BorderThickness="1" Padding="10,7" Margin="0,0,8,0" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="开始统计" FontSize="12"/>
                            <TextBlock x:Name="txtStartDate" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" x:Name="summaryRaceBorder" BorderThickness="1" Padding="10,7" Margin="0,0,8,0" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="赛文次数" FontSize="12"/>
                            <TextBlock x:Name="txtRaceAttempts" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="5" x:Name="summaryTypingDaysBorder" BorderThickness="1" Padding="10,7" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="打字天数" FontSize="12"/>
                            <TextBlock x:Name="txtTypingDays" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.22*"/>
                        <ColumnDefinition Width="0.78*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="300"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" x:Name="categoryHeaderGrid" MinHeight="34" Margin="0,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="分类统计" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="tglMergeCategoryProjects"
                                          Content="同分类合并"
                                          Margin="0,0,6,0"
                                          Checked="CategoryOption_Changed"
                                          Unchecked="CategoryOption_Changed"
                                          Style="{StaticResource PanelToggleStyle}"/>
                            <ToggleButton x:Name="tglShowHistoryCategory"
                                          Content="历史数据"
                                          Margin="0,0,6,0"
                                          Checked="CategoryOption_Changed"
                                          Unchecked="CategoryOption_Changed"
                                          Style="{StaticResource PanelToggleStyle}"/>
                            <Button x:Name="btnResetCategoryFocus"
                                    Content="显示全部"
                                    Margin="0,0,6,0"
                                    Click="BtnResetCategoryFocus_Click"
                                    Style="{StaticResource PanelButtonStyle}"/>
                            <Button x:Name="btnRefresh"
                                    Content="刷新"
                                    Click="BtnRefresh_Click"
                                    Style="{StaticResource PanelButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="1" x:Name="difficultyHeaderGrid" MinHeight="34" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="打文难度分布" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="txtDifficultyNote"
                                   Text="不含练单"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="1" Grid.Column="0" x:Name="categoryChartBorder" BorderThickness="1" Padding="0" Margin="0,0,12,0" CornerRadius="5">
                        <Grid x:Name="categoryPieHost"
                              Background="Transparent"
                              ClipToBounds="True"
                              SizeChanged="CategoryPieHost_SizeChanged">
                            <Canvas x:Name="categoryPieCanvas"/>
                            <Border x:Name="categoryPieHoverInfoBorder"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="14"
                                    Padding="8,5"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="txtCategoryPieHoverInfo"
                                           FontSize="12"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" x:Name="difficultyChartBorder" BorderThickness="1" Padding="12,10" CornerRadius="5">
                        <ItemsControl x:Name="difficultyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="difficultyRowRoot"
                                          MinHeight="46"
                                          Background="Transparent"
                                          MouseEnter="DifficultyRow_MouseEnter"
                                          MouseLeave="DifficultyRow_MouseLeave"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Grid.RenderTransform>
                                        <Border x:Name="difficultyRowHoverBg"
                                                Margin="-6,0"
                                                CornerRadius="5"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Border x:Name="difficultyBarTrack"
                                                        Height="10"
                                                        Background="{Binding TrackBrush}"
                                                        CornerRadius="5"
                                                        VerticalAlignment="Center"/>
                                                <Border x:Name="difficultyBarFill"
                                                        Height="10"
                                                        Background="{Binding BarBrush}"
                                                        Width="{Binding BarWidth}"
                                                        CornerRadius="5"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Words}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PercentText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <GridSplitter Grid.Row="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  x:Name="categoryDetailSplitter"
                                  Height="8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="Transparent"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"/>

                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="categoryDetailGrid" MinHeight="120">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="分类详情" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="txtCategoryFocus"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>
                        </Grid>
                        <Border Grid.Row="1" x:Name="categoryDetailBorder" BorderThickness="1" CornerRadius="5">
                            <DataGrid x:Name="dgCategory"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      CanUserSortColumns="False"
                                      CanUserAddRows="False"
                                      RowHeight="27"
                                      ColumnHeaderHeight="30"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="分类" Binding="{Binding DisplayName}" Width="*" MinWidth="220"/>
                                    <DataGridTextColumn Header="字数" Binding="{Binding Words}" Width="110" MinWidth="80"/>
                                    <DataGridTextColumn Header="次数" Binding="{Binding AttemptsText}" Width="90" MinWidth="70"/>
                                    <DataGridTextColumn Header="占比" Binding="{Binding PercentText}" Width="90" MinWidth="70"/>
                                    <DataGridTextColumn Header="开始统计" Binding="{Binding StartDate}" Width="120" MinWidth="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>

                <StatusBar x:Name="statusBar" Grid.Row="3" Margin="12,8,12,10">
                    <StatusBarItem>
                        <TextBlock x:Name="txtStatus" Text="就绪" FontSize="12"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Border>

        <Border Name="ResizeTop" Background="Transparent" Height="10" VerticalAlignment="Top" Cursor="SizeNS"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"/>
        <Border Name="ResizeBottom" Background="Transparent" Height="10" VerticalAlignment="Bottom" Cursor="SizeNS"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"/>
        <Border Name="ResizeLeft" Background="Transparent" Width="10" HorizontalAlignment="Left" Cursor="SizeWE"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"/>
        <Border Name="ResizeRight" Background="Transparent" Width="10" HorizontalAlignment="Right" Cursor="SizeWE"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"/>
        <Border Name="ResizeTopLeft" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"/>
        <Border Name="ResizeTopRight" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"/>
        <Border Name="ResizeBottomLeft" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"/>
        <Border Name="ResizeBottomRight" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"/>
    </Grid>
</Window>
