  <!-- 编译前自动更新 version.txt 为今天日期，然后读取并更新 GeneratedVersion.cs -->
  <Target Name="UpdateVersionFromTxt" BeforeTargets="CoreCompile">
    <!-- 自动生成今天的日期作为版本号 (YYYYMMDD 格式) -->
    <PropertyGroup>
      <TodayVersion>$([System.DateTime]::Now.ToString('yyyyMMdd'))</TodayVersion>
    </PropertyGroup>
    <!-- 写入 version.txt -->
    <WriteLinesToFile File="Version\version.txt" Lines="$(TodayVersion)" Overwrite="true" />
    <!-- 从 version.txt 读取版本号 -->
    <ReadLinesFromFile File="Version\version.txt">
      <Output TaskParameter="Lines" ItemName="VersionLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <VersionNumber>@(VersionLines->'%(Identity)')</VersionNumber>
    </PropertyGroup>
    <!-- 生成 GeneratedVersion.cs -->
    <WriteLinesToFile File="Version\GeneratedVersion.cs" Overwrite="true" Lines="// &lt;auto-generated/&gt;" />
    <WriteLinesToFile File="Version\GeneratedVersion.cs" Overwrite="false" Lines="// 此文件由 MSBuild 在编译时自动生成，请勿手动修改" />
    <WriteLinesToFile File="Version\GeneratedVersion.cs" Overwrite="false" Lines="// 来源：编译时自动生成的日期 (YYYYMMDD)" />
    <WriteLinesToFile File="Version\GeneratedVersion.cs" Overwrite="false" Lines="" />
    <WriteLinesToFile File="Version\GeneratedVersion.cs" Overwrite="false" Lines="namespace TypeSunny" />
    <WriteLinesToFile File="Version\GeneratedVersion.cs" Overwrite="false" Lines="{" />
    <WriteLinesToFile File="Version\GeneratedVersion.cs" Overwrite="false" Lines="    internal static class GeneratedVersion" />
    <WriteLinesToFile File="Version\GeneratedVersion.cs" Overwrite="false" Lines="    {" />
    <WriteLinesToFile File="Version\GeneratedVersion.cs" Overwrite="false" Lines="$([System.String]::Format('        public const string CurrentVersion = &quot;{0}&quot;;', '$(VersionNumber.Trim())'))" />
    <WriteLinesToFile File="Version\GeneratedVersion.cs" Overwrite="false" Lines="    }" />
    <WriteLinesToFile File="Version\GeneratedVersion.cs" Overwrite="false" Lines="}" />
    <PropertyGroup>
      <ReleasePackagePublishedUtcTicks Condition="'$(ReleasePackagePublishedUtcTicks)' == ''">0</ReleasePackagePublishedUtcTicks>
    </PropertyGroup>
    <WriteLinesToFile File="Version\CompiledReleaseIdentity.cs" Overwrite="true" Lines="// &lt;auto-generated/&gt;" />
    <WriteLinesToFile File="Version\CompiledReleaseIdentity.cs" Overwrite="false" Lines="namespace TypeSunny" />
    <WriteLinesToFile File="Version\CompiledReleaseIdentity.cs" Overwrite="false" Lines="{" />
    <WriteLinesToFile File="Version\CompiledReleaseIdentity.cs" Overwrite="false" Lines="    internal static class CompiledReleaseIdentity" />
    <WriteLinesToFile File="Version\CompiledReleaseIdentity.cs" Overwrite="false" Lines="    {" />
    <WriteLinesToFile File="Version\CompiledReleaseIdentity.cs" Overwrite="false" Lines="$([System.String]::Format('        public const string Version = &quot;{0}&quot;;', '$(VersionNumber.Trim())'))" />
    <WriteLinesToFile File="Version\CompiledReleaseIdentity.cs" Overwrite="false" Lines="$([System.String]::Format('        public static readonly long PackagePublishedUtcTicks = {0}L;', '$(ReleasePackagePublishedUtcTicks.Trim())'))" />
    <WriteLinesToFile File="Version\CompiledReleaseIdentity.cs" Overwrite="false" Lines="" />
    <WriteLinesToFile File="Version\CompiledReleaseIdentity.cs" Overwrite="false" Lines="$([System.String]::Format('        public static System.DateTime PackagePublishedUtc =&gt; ReleaseIdentity.FromUtcTicks(PackagePublishedUtcTicks){0}', ';'))" />
    <WriteLinesToFile File="Version\CompiledReleaseIdentity.cs" Overwrite="false" Lines="    }" />
    <WriteLinesToFile File="Version\CompiledReleaseIdentity.cs" Overwrite="false" Lines="}" />
  </Target>

